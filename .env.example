# GitHub App installed only on donavonguyot/Foreman; no webhook triggers for the pilot.
GITHUB_CONNECTOR=github/foreman
FACTORY_REPO=donavonguyot/Foreman

# Initialize every station from the separately reviewed bootstrap branch.
# Replace this with pnpm install --frozen-lockfile after bootstrap is merged.
FACTORY_SETUP_COMMAND="git fetch https://github.com/donavonguyot/Foreman.git bootstrap/node24-self-hosting && git checkout -b bootstrap/node24-self-hosting FETCH_HEAD && pnpm install --frozen-lockfile"

# Optional; automatic intake remains inactive until connector triggers are enabled.
# FACTORY_LABEL=factory
# FACTORY_BRANCH_PREFIX=factory/
# FACTORY_BOT_NAME=donavonguyot-foreman
